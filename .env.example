APP_NAME="Billeterie Express"
ASSET_VERSION=2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billeterie_express
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@billeterie-express.sn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
#  DEXCHANGE PAY (dexpay.africa) —_MODE: sandbox | live
#  Sandbox : pk_test_xxx / sk_test_xxx  (aucun paiement réel)
#  Live    : pk_live_xxx / sk_live_xxx
# ─────────────────────────────────────────────────────────────
DEXPAY_MODE=sandbox
DEXPAY_API_KEY=pk_test_xxx
DEXPAY_API_SECRET=sk_test_xxx

# Facultatif : secret sandbox conservé pour vérifier les webhooks des sessions
# sandbox encore ouvertes une fois passé en production (chaque webhook est signé
# avec la clé qui a créé la transaction).
DEXPAY_API_SECRET_SANDBOX=

DEXPAY_BASE_URL=https://api-sandbox.dexpay.africa/api/v1
DEXPAY_CURRENCY=XOF
DEXPAY_COUNTRY_ISO=SN
DEXPAY_CLIENT_SUPPORT_FEE=true

# Surcharge (%) ajoutée au prix du ticket pour couvrir le frais de retrait du
# marchand (0 = désactiver). Réglez le même taux que les frais DexPay négociés.
DEXPAY_SERVICE_FEE_RATE=0

# ─────────────────────────────────────────────────────────────
#  PDF DES BILLETS — impression fidèle via navigateur headless
#  Chrome/Edge sont détectés automatiquement. Renseignez un chemin
#  explicite si le binaire n'est pas dans un emplacement standard.
#
#  TICKET_PDF_ENGINE : auto (défaut) = navigateur si dispo, sinon repli
#  dompdf (pur PHP, aucun logiciel à installer) ; "dompdf" force le repli
#  (serveur mutualisé) ; "browser" exige un navigateur.
# ─────────────────────────────────────────────────────────────
# TICKET_PDF_CHROME="C:\Program Files\Google\Chrome\Application\chrome.exe"
# TICKET_PDF_WKHTMLTOPDF="/usr/bin/wkhtmltopdf"
# TICKET_PDF_ENGINE=auto

# ─────────────────────────────────────────────────────────────
#  WHATSAPP CLOUD API (Meta) — envoi automatique du billet
#  Laissez WHATSAPP_ENABLED=false tant que le compte n'est pas prêt.
#  WHATSAPP_TOKEN = jeton permanent (System User), WHATSAPP_PHONE_NUMBER_ID =
#  identifiant du numéro expéditeur. Le modèle doit être approuvé (utilitaire)
#  avec un en-tête image, un corps à 2 variables et, si présent, un bouton
#  CTA dynamique ("Voir mon billet").
# ─────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
